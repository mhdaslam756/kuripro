NODE_ENV=development
PORT=4000

# MongoDB must be a replica set (even a single-node one) — auth registration uses transactions.
# Local: mongodb://localhost:27017/kuripro?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kuripro
MONGODB_URI=mongodb://localhost:27017/kuripro?replicaSet=rs0

# Local Redis:            redis://localhost:6379
# Managed/TLS Redis (Upstash, Redis Cloud, ElastiCache in-transit encryption, …) MUST use the
# rediss:// scheme. A plain redis:// connection to a TLS-only endpoint is accepted then instantly
# reset by the server (read ECONNRESET on every connect) — it never becomes usable.
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

CORS_ORIGIN=http://localhost:5173

# File uploads (member docs, chit documents, logos). Leave blank to run without uploads configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (server-side push via FCM). Leave blank to run without push delivery.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Notification channel providers — all optional. When a channel's vars are unset it stays dormant and
# the dev console logs the message instead (see modules/notifications/channels).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Email provider options (Resend or SMTP):
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=

# Option B: SMTP (e.g. Gmail with App Password, Brevo, AWS SES, or custom SMTP)
# For Gmail: set SMTP_SERVICE=gmail, SMTP_USER=yourname@gmail.com, SMTP_PASS=your-16-char-app-password
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# WebAuthn / passkeys (biometric login). RP_ID is the registrable domain (no scheme/port); ORIGIN is
# the full browser origin. The defaults below work for local development out of the box.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=KuriPro
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Frontend (frontend/.env) — client push via Firebase Cloud Messaging web. All public config; when
# any are absent the app reports push "not configured" and the rest of the flow still works. ---
# VITE_API_URL=http://localhost:4000/api
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
